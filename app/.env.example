# Cluster al que se conecta el frontend: localnet | devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# RPC opcional; si se omite se usa el endpoint público del cluster (o http://127.0.0.1:8899 en localnet)
NEXT_PUBLIC_RPC_URL=
# Program ID del marketplace desplegado (el mismo en localnet y devnet)
NEXT_PUBLIC_PROGRAM_ID=5HwkQykA3irfntrPftwmDc2dcSUjRP3RwYga8Y3Yu6DE
# Admin que inicializó el marketplace (la app deriva su PDA). Sin él no se listan ni publican NFTs.
# Valor por defecto: marketplace de demostración en devnet. En localnet usa el que imprime `pnpm app:seed`.
NEXT_PUBLIC_MARKETPLACE_ADMIN=9jbUzfSbDoc7hdzVD5iNDwnu9A9MMtKAkC4dQsbyPGm4
